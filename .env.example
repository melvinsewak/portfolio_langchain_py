# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Optional: Temperature setting (0.0 to 1.0)
TEMPERATURE=0.7

# Optional: Max tokens for responses
MAX_TOKENS=1000

# Optional: Verbose logging (true/false)
VERBOSE=false

# For RAG examples - Vector store configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# For document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
