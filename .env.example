# ============================================
# LLM Provider Configuration
# ============================================
# Choose your LLM provider: "openai" or "azure"
LLM_PROVIDER=openai

# ============================================
# OpenAI Configuration
# ============================================
# For standard OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# Azure OpenAI Configuration
# ============================================
# For Azure OpenAI from Microsoft Foundry
# Uncomment and configure these when using LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============================================
# Common LLM Settings
# ============================================
# Temperature setting (0.0 to 1.0)
TEMPERATURE=0.7

# Max tokens for responses
MAX_TOKENS=1000

# Verbose logging (true/false)
VERBOSE=false

# ============================================
# Vector Store Configuration
# ============================================
# For RAG examples - Vector store configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ============================================
# Document Processing Configuration
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
